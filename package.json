{
  "name": "dsh-cover-pipeline",
  "version": "1.1.3",
  "private": true,
  "description": "DSH local cover pipeline: separation, conversion, shift, mix and verification; external audio dependencies required",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "ai-cover",
    "ddsp",
    "msst"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/regression.mjs",
    "test:contract": "node test/harness.mjs",
    "test:package": "node test/package.mjs",
    "test:workflow": "node test/workflow.mjs",
    "test:setup": "node test/setup.mjs",
    "verify:materials": "node scripts/verify-materials.mjs",
    "test:host": "node scripts/test-dsh-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "src/*.js",
    "runtime/*.py",
    "materials/*.json",
    "materials/*.md",
    "scripts/*.mjs",
    "scripts/*.ps1",
    "cordis.patch.yml",
    "cordis.dev.yml",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/InariNGT-Ofiicial/dsh-cover-pipeline.git"
  }
}
